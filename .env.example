# Copy to .env and fill in values
FFMPEG_BIN=C:\speedwatch\ffmpeg.exe
FFPROBE_BIN=C:\speedwatch\ffprobe.exe
CAMERA_RTSP=rtsps://<ROUTER_IP>:7441/<DETECT_STREAM_KEY>?enableSrtp
CAMERA_RTSP_HQ=rtsps://<ROUTER_IP>:7441/<RECORD_STREAM_KEY>
CAMERA_NAME=<camera_name>

# Inference
YOLO_MODEL=models/yolo11m.onnx
ONNX_PROVIDER=auto

# Detection
OBJECT_CLASSES=car,truck,bus
DETECT_FPS=12
MIN_DT_SECONDS=0.3

# Speed banding (UI colour bands): green < warn, amber warn..limit, red > limit
SPEED_LIMIT_MPH=20
SPEED_WARN_MPH=16

# Storage
DATA_DIR=C:\speedwatch\data
PORT=8765
# 127.0.0.1 = localhost only; 0.0.0.0 = reachable from other LAN devices (needs firewall rule)
HOST=127.0.0.1

# Authentication (Google SSO). Auth is ENABLED whenever GOOGLE_CLIENT_ID is set; leave it
# blank only for localhost dev. Create a Web OAuth client in Google Cloud Console with the
# redirect URI below. SESSION_SECRET: any long random string (e.g. python -c
# "import secrets;print(secrets.token_urlsafe(48))"). BOOTSTRAP_ADMIN is seeded as admin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
OAUTH_REDIRECT_URI=https://speedwatch.e49ta.com/auth/callback
BOOTSTRAP_ADMIN=
# SESSION_MAX_AGE=2592000

# ANPR / number-plate recognition (fast-alpr; models auto-download on first run)
ENABLE_ALPR=1
ALPR_DETECTOR_MODEL=yolo-v9-t-512-license-plate-end2end
ALPR_OCR_MODEL=european-plates-mobile-vit-v2-model
ALPR_MIN_CONF=0.6

# Vehicle descriptions (OPTIONAL — needs a local model host like Ollama).
# Set VEHICLE_AUTODESCRIBE=0 to disable; the rest of the pipeline does not use this.
OLLAMA_URL=http://localhost:11434
VEHICLE_VISION_MODEL=llama3.2-vision:11b
VEHICLE_AUTODESCRIBE=1
VEHICLE_MIN_PASSES=3
VEHICLE_VISION_TIMEOUT=180
# VEHICLE_VISION_PROMPT=<override the default colour/make/model prompt>

# Plate-merge suggestion sensitivity (OCR-aware soft edit distance)
ALIAS_SUGGEST_MAXDIST=1.5

# Vehicle Re-ID embeddings (visual grouping of plateless / look-alike cars).
# Model (models/vehicle-reid-0001.onnx) is fetched by bootstrap.ps1; absent = features no-op.
REID_MODEL=models/vehicle-reid-0001.onnx
REID_PROVIDER=cpu
# Cosine similarity to treat two crops as the same car (tune on real footage).
REID_SIM_THRESHOLD=0.7
