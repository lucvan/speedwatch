# Copy to .env and fill in values
FFMPEG_BIN=C:\speedwatch\ffmpeg.exe
FFPROBE_BIN=C:\speedwatch\ffprobe.exe
CAMERA_RTSP=rtsps://<ROUTER_IP>:7441/<DETECT_STREAM_KEY>?enableSrtp
CAMERA_RTSP_HQ=rtsps://<ROUTER_IP>:7441/<RECORD_STREAM_KEY>
CAMERA_NAME=<camera_name>

# Inference
YOLO_MODEL=models/yolo11m.onnx
ONNX_PROVIDER=auto

# Detection
OBJECT_CLASSES=car,truck,bus
DETECT_FPS=12
MIN_DT_SECONDS=0.3

# Storage
DATA_DIR=C:\speedwatch\data
PORT=8765
